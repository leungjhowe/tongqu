{
  "name": "tps",
  "private": true,
  "version": "0.1.0",
  "description": "交通规划AI工作流系统 - Tauri 2 monorepo",
  "scripts": {
    "dev": "pnpm --filter @tps/desktop dev",
    "build": "pnpm --filter @tps/desktop build",
    "tauri:dev": "pnpm --filter @tps/desktop tauri:dev",
    "tauri:build": "pnpm --filter @tps/desktop tauri:build",
    "lint": "pnpm -r --parallel lint",
    "clean": "pnpm -r --parallel clean",
    "db:server": "node scripts/start-libsql-server.mjs",
    "db:dev": "concurrently -n server,vite -c blue,green \"pnpm db:server\" \"pnpm dev\""
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@unocss/preset-icons": "^0.62.4",
    "@unocss/preset-uno": "^0.62.4",
    "@unocss/reset": "^0.62.4",
    "concurrently": "^10.0.3",
    "sass": "^1.79.4",
    "sqld": "0.24.1-pre.42",
    "unocss": "^0.62.4"
  }
}
