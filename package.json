{
  "name": "tps",
  "private": true,
  "version": "0.1.0",
  "description": "交通规划AI工作流系统 - Tauri 2 monorepo",
  "scripts": {
    "dev": "pnpm --filter @tps/desktop dev",
    "build": "pnpm --filter @tps/desktop build",
    "tauri:dev": "pnpm --filter @tps/desktop tauri:dev",
    "tauri:build": "pnpm --filter @tps/desktop tauri:build",
    "lint": "pnpm -r --parallel lint",
    "clean": "pnpm -r --parallel clean"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "class-variance-authority": "^0.7.0"
  },
  "devDependencies": {
    "sass": "^1.79.4",
    "unocss": "^0.62.4",
    "@unocss/preset-uno": "^0.62.4",
    "@unocss/preset-icons": "^0.62.4",
    "@unocss/reset": "^0.62.4"
  }
}
