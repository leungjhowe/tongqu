{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@tongqu/shared": ["./packages/shared/src/index.ts"],
      "@tongqu/shared/*": ["./packages/shared/src/*"],
      "@tongqu/ui": ["./packages/ui/src/index.ts"],
      "@tongqu/ui/*": ["./packages/ui/src/index.ts"],
      "@tongqu/workflow-core": ["./packages/workflow-core/src/index.ts"],
      "@tongqu/workflow-core/*": ["./packages/workflow-core/src/*"],
      "@tongqu/workflow-ui": ["./packages/workflow-ui/src/index.ts"],
      "@tongqu/workflow-ui/*": ["./packages/workflow-ui/src/*"],
      "@tongqu/gis-core": ["./packages/gis-core/src/index.ts"],
      "@tongqu/gis-core/*": ["./packages/gis-core/src/*"],
      "@tongqu/data-core": ["./packages/data-core/src/index.ts"],
      "@tongqu/data-core/*": ["./packages/data-core/src/*"],
      "@tongqu/ai-core": ["./packages/ai-core/src/index.ts"],
      "@tongqu/ai-core/*": ["./packages/ai-core/src/*"],
      "@tongqu/asset-core": ["./packages/asset-core/src/index.ts"],
      "@tongqu/asset-core/*": ["./packages/asset-core/src/*"],
      "@tongqu/export-core": ["./packages/export-core/src/index.ts"],
      "@tongqu/export-core/*": ["./packages/export-core/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "**/target", "**/node_modules"]
}
